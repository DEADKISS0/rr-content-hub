# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python: estos son binarios que se regeneran solos y no van al repo
__pycache__/
*.pyc

# Rastos de Playwright: traces, capturas y contextos de error. Se regeneran
# con cada corrida y no son fuente. Estaban versionados y cada `npx playwright
# test` dejaba cientos de archivos modificados.
test-results/
playwright-report/
.vitest/
